								"v1",
								"underwriting",
								"assess"
							]
						}
					},
					"response": []
				},
				{
					"name": "Apply Underwriting Manual Override",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{gateway_url}}/api/v1/underwriting/override/{{assessmentId}}?decision=APPROVED&reason=Strong+assets+and+credit+score&underwriter=SeniorOfficer",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"v1",
								"underwriting",
								"override",
								"{{assessmentId}}"
							],
							"query": [
								{
									"key": "decision",
									"value": "APPROVED"
								},
								{
									"key": "reason",
									"value": "Strong+assets+and+credit+score"
								},
								{
									"key": "underwriter",
									"value": "SeniorOfficer"
								}
							]
						}
					},
					"response": []
				}
			]
		},
