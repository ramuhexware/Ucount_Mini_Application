		{
			"name": "4. Underwriting Service API",
			"item": [
				{
					"name": "Assess Loan Underwriting",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"loanId\": \"{{loanId}}\",\n    \"customerId\": \"{{customerId}}\",\n    \"applicantIncome\": 120000,\n    \"existingMonthlyDebt\": 1500,\n    \"creditScore\": 750,\n    \"requestedLoanAmount\": 350000,\n    \"propertyValue\": 450000\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/v1/underwriting/assess",
