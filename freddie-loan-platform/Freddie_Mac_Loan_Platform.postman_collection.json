			"name": "1. Authentication & Security API",
			"item": [
				{
					"name": "User Login & JWT Generation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"officer\",\n    \"password\": \"officer123\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/v1/auth/login",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
